# Server
PORT=8080
GRPC_PORT=9090
GRPC_MAX_RECV_MSG_SIZE=10485760  # 10 MB — максимальный размер gRPC сообщения
READ_TIMEOUT=10s
WRITE_TIMEOUT=30s
IDLE_TIMEOUT=2m                 # keep-alive соединения без активности закрываются
SHUTDOWN_TIMEOUT=15s

# Limits
MAX_BODY_BYTES=10485760         # 10 MB — максимальный размер HTTP body
MAX_DECOMPRESSED_BYTES=20971520  # 20 MB — лимит после распаковки zlib (защита от zip bomb)
MAX_POINTS=50000                # максимум точек в маршруте
RESOLVE_TIMEOUT=25s             # таймаут обработки маршрута (чуть меньше WRITE_TIMEOUT)

# Pipeline
DEDUP_DISTANCE_METERS=2.0      # точки ближе этого расстояния склеиваются
DEDUP_TIME_GAP=60s              # максимальный разрыв по времени для склейки
MAX_SPEED_KMH=150               # скорость выше — GPS-телепорт, точка удаляется
MAX_LOOP_METERS=100             # петли больше — считаем реальными (не удаляем)
MAX_LOOP_SECONDS=10             # петли длиннее — считаем реальными (не удаляем)
INTERSECT_MAX_ITER=10000        # лимит итераций поиска пересечений
# SIMPLIFY_MIN_METERS=2.0       # post-MVP: минимальная длина сегмента (Дугласа-Пекера)

# Swagger / Debug (включать только для локальной разработки)
SWAGGER_ENABLED=false
GRPC_REFLECTION=false

# Logging
LOG_LEVEL=info                  # debug / info / warn / error

# OSRM (post-MVP)
# USE_OSRM=false
# OSRM_URL=
