# Server
PORT=8080
GRPC_PORT=9090
GRPC_MAX_RECV_MSG_SIZE=10485760  # 10 MB — максимальный размер gRPC сообщения
READ_TIMEOUT=10s
WRITE_TIMEOUT=30s
IDLE_TIMEOUT=2m                 # keep-alive соединения без активности закрываются
SHUTDOWN_TIMEOUT=15s

# Limits
MAX_BODY_BYTES=10485760         # 10 MB — максимальный размер HTTP body
MAX_DECOMPRESSED_BYTES=20971520  # 20 MB — лимит после распаковки zlib (защита от zip bomb)
MAX_POINTS=50000                # максимум точек в маршруте
RESOLVE_TIMEOUT=25s             # таймаут обработки маршрута (чуть меньше WRITE_TIMEOUT)

# Pipeline (этапы очистки идут по порядку)

# 1. sort_by_time — сортировка точек по времени (без параметров)

# 2. remove_anchor_backtrack — якорный фильтр: режет «откаты» (точка дёрнулась назад к старту И от цели), способ 2+1
ANCHOR_BACKTRACK_TOLERANCE_METERS=0  # порог значимого отката (м); 0 = ВЫКЛ. Для включения старт ~100, подбирать на коротких сегментах по карте

# 3. remove_teleports — вырезает спуфинг-загоны (трек улетел в аэропорт и вернулся)
TELEPORT_JUMP_METERS=15000      # скачок между соседними точками больше этого (м) = подозрение на телепорт
TELEPORT_RETURN_METERS=2000     # трек вернулся ближе этого (м) к точке перед скачком = это загон
TELEPORT_MAX_SPAN_METERS=5000   # вырезаем загон, только если его размах меньше этого (м): спуфинг компактен, реальная поездка растянута

# 4. filter_by_speed — выкидывает точки с нереальной скоростью
MAX_SPEED_KMH=150               # скорость выше — GPS-телепорт, точка удаляется

# 5. filter_by_acceleration — выкидывает точки с аномальным ускорением
MAX_ACCEL_KMH_PER_SEC=20        # ускорение выше (км/ч за секунду) — GPS-глюк, точка удаляется

# 6. deduplicate — склеивает дубли (близкие И по месту, И по времени)
DEDUP_DISTANCE_METERS=2.0       # точки ближе этого (м) склеиваются...
DEDUP_TIME_GAP=60s              # ...если разрыв по времени между ними меньше этого

# 7. collapse_stops — сворачивает стоянки (кучи точек на месте) в одну точку
STOP_RADIUS_METERS=50           # размер пятна стоянки (м)
STOP_MIN_POINTS=5               # от скольких точек в пятне считаем это стоянкой (а не проездом)

# 8. simplify — прореживает лишние точки на прямых (Дугласа-Пекера)
SIMPLIFY_MIN_METERS=5.0         # точки ближе этого (м) к прямой убираются

# Redis (async: очередь задач + хранилище результатов)
REDIS_ADDR=localhost:6379       # адрес Redis (хост:порт)
REDIS_DB=10                     # логическая база Redis (ящик №10)
REDIS_PASSWORD=                 # пароль (пусто = без пароля)
WORKER_COUNT=4                  # число воркеров-горутин на разбор очереди
RESULT_TTL=1h                   # сколько результат живёт в Redis, потом авто-удаление

# Callback (Go → Laravel по готовности задачи)
CALLBACK_URL=                   # шаблон с плейсхолдером {taskKey}; пусто = коллбэки выключены
CALLBACK_RETRIES=3              # число повторов сверх первой попытки (на сетевую ошибку и 5xx)
CALLBACK_TIMEOUT=5s             # таймаут на один HTTP-запрос коллбэка

# Swagger / Debug (включать только для локальной разработки)
SWAGGER_ENABLED=false
GRPC_REFLECTION=false

# Logging
LOG_LEVEL=info                  # debug / info / warn / error

# OSRM (post-MVP)
# USE_OSRM=false
# OSRM_URL=
