# ariadne — пример настроек. Скопировать в `.env` и поправить под себя.
#
# ПРАВИЛО ОФОРМЛЕНИЯ: комментарий пишется НАД переменной, никогда в её строке.
# docker compose отрезает хвостовой комментарий только у НЕПУСТОГО значения.
# У пустого (`KEY=        # текст`) он сначала съедает пробелы, и значением
# становится сам текст комментария. Так «выключенные» коллбэки однажды начали
# слать запросы в никуда: `CALLBACK_URL` уехал в контейнер как `# шаблон...`.

# ---------------------------------------------------------------- Сервер ----

PORT=8080
GRPC_PORT=9090

# 10 MB — максимальный размер gRPC-сообщения
GRPC_MAX_RECV_MSG_SIZE=10485760

READ_TIMEOUT=10s
WRITE_TIMEOUT=30s

# keep-alive соединения без активности закрываются
IDLE_TIMEOUT=2m

SHUTDOWN_TIMEOUT=15s

# ---------------------------------------------------------------- Лимиты ----

# 10 MB — максимальный размер HTTP body
MAX_BODY_BYTES=10485760

# 20 MB — потолок после распаковки zlib (защита от zip-бомбы)
MAX_DECOMPRESSED_BYTES=20971520

# максимум точек в маршруте
MAX_POINTS=50000

# бюджет на обработку одного маршрута. Из него чистке достаётся 80 %,
# остаток — дорисовке. Исчерпание бюджета не валит задачу: она отдаётся
# с пометкой «неполная».
RESOLVE_TIMEOUT=25s

# ------------------------------------------------------------- Упаковка ----
#
# Пороги трёх стадий, которые сжимают уже очищенный трек. Всё остальное в
# чистке и дорисовке задано константами в коде и сюда НЕ вынесено намеренно:
# эти числа выверены по эталону на Python и проверяются золотыми тестами.
# Ручка в окружении дала бы бою тихо разойтись с эталоном, и ни один тест
# этого бы не заметил.

# точки ближе этого (м) склеиваются...
DEDUP_DISTANCE_METERS=2.0

# ...если разрыв по времени между ними меньше этого
DEDUP_TIME_GAP=60s

# размер пятна стоянки (м)
STOP_RADIUS_METERS=50

# от скольких точек в пятне считаем это стоянкой, а не проездом
STOP_MIN_POINTS=5

# точки ближе этого (м) к прямой убираются (Дугласа-Пекер)
SIMPLIFY_MIN_METERS=5.0

# ------------------------------------------------------------------ OSRM ----
#
# Маршрутизатор, на котором держится вся чистка: снэпы дают точке вес,
# расстояния по дорогам проверяют переходы, геометрия дорисовывает дыры
# связи (+5.4 % километража).

# адрес OSRM, например http://osrm:5000.
# Пусто = чистка и дорисовка пропускают трек насквозь с предупреждением:
# сервис работает, но километраж занижен, а спуфинг не убирается.
OSRM_URL=

# потолок на ОДИН запрос; бюджет задачи всё равно главнее
OSRM_TIMEOUT=30s

# сколько запросов держим в полёте на ВЕСЬ сервис
OSRM_MAX_PARALLEL=16

# повторы на ВРЕМЕННЫЙ отказ (сеть моргнула, 5xx, таймаут).
# 0 = не повторять: один потерянный запрос оставит дыру недорисованной,
# километраж занизится, и никто не узнает.
OSRM_RETRIES=2

# ----------------------------------------------------------------- Redis ----
#
# Асинхронный режим: очередь задач и хранилище результатов.

# адрес Redis (хост:порт). Под docker compose — имя сервиса: redis:6379
REDIS_ADDR=localhost:6379

# логическая база Redis (ящик №10)
REDIS_DB=10

# пароль. Пусто = без пароля
REDIS_PASSWORD=

# число воркеров-горутин, разбирающих очередь
WORKER_COUNT=4

# сколько результат живёт в Redis, потом авто-удаление
RESULT_TTL=1h

# ------------------------------------------------------------- Коллбэки ----
#
# Go → Laravel по готовности задачи.

# шаблон адреса с плейсхолдером {taskKey}. Пусто = коллбэки выключены
CALLBACK_URL=

# число повторов сверх первой попытки (на сетевую ошибку и 5xx)
CALLBACK_RETRIES=3

# таймаут на один HTTP-запрос коллбэка
CALLBACK_TIMEOUT=5s

# --------------------------------------------------------- Swagger/Debug ----
#
# Включать только для локальной разработки.

SWAGGER_ENABLED=false
GRPC_REFLECTION=false

# --------------------------------------------------------------- Логи ----

# debug / info / warn / error
LOG_LEVEL=info
